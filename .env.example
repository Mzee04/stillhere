# Local demo server
PORT=4173

# Kane CLI executable and run timeout. Kane credentials stay in Kane's own profile.
KANE_CLI=kane-cli
KANE_TIMEOUT_SECONDS=300
KANE_HEADLESS=false
KANE_CLI_USER_AGENT=codex

# Number of Kane runs, including the initial run. The default is 2 (before and after repair).
STILLHERE_MAX_ATTEMPTS=2

# Optional coding-agent command. It must read its repair prompt from stdin and edit this project.
# Codex CLI example (the trailing dash reads the prompt from stdin):
STILLHERE_AGENT_COMMAND="codex exec --sandbox workspace-write --skip-git-repo-check -"
